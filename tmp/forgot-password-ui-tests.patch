+import { expect, test } from '@playwright/test';
+
+async function installResetMocks(page) {
+  const requests = [];
+  await page.route('**/api/**', async (route) => {
+    const pathname = new URL(route.request().url()).pathname;
+    let status = 200;
+    let body = {};
+    if (pathname === '/api/me') body = { user: null };
+    else if (pathname === '/api/forgot-password') {
+      const values = route.request().postDataJSON();
+      requests.push(values);
+      const matches = values.username === 'candidate' && values.contact === 'candidate@example.test';
+      status = matches ? 200 : 400;
+      body = { message: matches ? 'Đổi mật khẩu thành công.' : 'Tên đăng nhập hoặc email không khớp với tài khoản khả dụng.' };
+    }
+    await route.fulfill({ status, contentType: 'application/json', body: JSON.stringify(body) });
+  });
+  return requests;
+}
+
+test('Quên mật khẩu yêu cầu tên đăng nhập và email, không hiển thị nhãn demo', async ({ page }) => {
+  const requests = await installResetMocks(page);
+  await page.goto('/forgot-password');
+  await expect(page.getByRole('heading', { name: 'Quên mật khẩu', exact: true })).toBeVisible();
+  await expect(page.getByText('Đặt lại mật khẩu · Bản demo', { exact: true })).toHaveCount(0);
+  await expect(page.getByLabel('Tên đăng nhập', { exact: true })).toBeVisible();
+  await expect(page.getByLabel('Email của tài khoản', { exact: true })).toBeVisible();
+  await page.getByRole('button', { name: 'Đặt lại mật khẩu', exact: true }).click();
+  await expect(page.getByText('Vui lòng nhập tên đăng nhập.', { exact: true })).toBeVisible();
+  await expect(page.getByText('Vui lòng nhập email của tài khoản.', { exact: true })).toBeVisible();
+  expect(requests).toHaveLength(0);
+});
+
