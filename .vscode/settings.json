{
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 700,
  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.recipe.default": "pdflatex",
  "latex-workshop.formatting.latex": "tex-fmt",
  "latex-workshop.formatting.tex-fmt.path": "C:\\Users\\SOP\\AppData\\Local\\Programs\\tex-fmt\\tex-fmt.exe",
  "latex-workshop.formatting.tex-fmt.args": ["--nowrap"],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex",
      "tools": ["pdflatex"]
    },
    {
      "name": "latexmk",
      "tools": ["latexmk"]
    },
    {
      "name": "Build with MiKTeX texify",
      "tools": ["miktex-texify"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "C:\\Users\\SOP\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\latexmk.exe",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "pdflatex",
      "command": "C:\\Users\\SOP\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\pdflatex.exe",
      "args": [
        "--enable-installer",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "miktex-texify",
      "command": "C:\\Users\\SOP\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\texify.exe",
      "args": [
        "--pdf",
        "--synctex=1",
        "--tex-option=--enable-installer",
        "--tex-option=--interaction=nonstopmode",
        "--tex-option=--file-line-error",
        "%DOC%"
      ],
      "env": {}
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.message.error.show": true,
  "latex-workshop.message.warning.show": false,
  "workbench.editorAssociations": {
    "*.pdf": "latex-workshop-pdf-hook"
  }
}
